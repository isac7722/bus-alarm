APP_ENV=local
MOCK_ARRIVALS=false
SEOUL_BUS_API_KEY=
SEOUL_BUS_API_BASE_URL=http://ws.bus.go.kr/api/rest/stationinfo
# Optional: decoded data.go.kr key approved for Gyeonggi station AND arrival APIs.
# Empty keeps Seoul-only mode; MOCK_ARRIVALS ignores both providers.
GYEONGGI_BUS_API_KEY=
GYEONGGI_BUS_API_BASE_URL=https://apis.data.go.kr/6410000
DATABASE_URL=postgresql+asyncpg://buswidget:buswidget@localhost:5432/buswidget
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30
HTTP_TIMEOUT_SECONDS=5
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
STATION_CATALOG_PATH=../seoul_bus_statiosn.xlsx
CORS_ORIGINS=[]

# Live Activities: all three values enable the worker; leave empty to disable it.
# This is an Apple Developer APNs key, not an App Store Connect API key.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=com.pangjoong.BusWidget

# Enable only after routes-check and device verification. Existing v2 saved
# selections keep working when discovery is disabled. No DB reimport needed.
ROUTE_MAP_ENABLED=false
